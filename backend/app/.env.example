# Database
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/modelens

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=generate-a-secure-secret-key-for-production-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage Config
# Can be 'local' or 's3'
STORAGE_BACKEND=local

# AWS S3 Configurations (required if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=mock_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key
AWS_STORAGE_BUCKET_NAME=modelens-assets-bucket
AWS_S3_REGION_NAME=us-east-1

# MLflow Tracking
MLFLOW_URI=http://localhost:5000

# Stripe Billing
STRIPE_API_KEY=sk_test_mock_key
STRIPE_WEBHOOK_SECRET=whsec_mock_secret
STRIPE_MOCK_MODE=True

# Email Provider (for low-credit alerts)
# Supported: 'sendgrid' or 'ses'
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SES_REGION=us-east-1
FROM_EMAIL=no-reply@modelens.com
# ComfyUI / Comfy Cloud
COMFYUI_URL=http://localhost:8188
COMFYUI_MOCK_MODE=True
# COMFY_CLOUD_API_KEY=your_comfy_cloud_api_key_here

