# Database
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/modelens

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=generate-a-secure-secret-key-for-production-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage
STORAGE_BACKEND=local

# MLflow
MLFLOW_URI=http://localhost:5000

# Email Provider
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SES_REGION=us-east-1
FROM_EMAIL=no-reply@modelens.com

# Stripe
STRIPE_API_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_MOCK_MODE=true

# Environment: development | local | staging | production
APP_ENV=development
# true only in automated test runs (enables mock SSO credentials outside production)
TESTING=false

# SSO identity verification (server-side)
# Google OAuth client ID; ID tokens must have this as their audience
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GitHub OAuth app, used to exchange authorization codes server-side
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# Accept "mock:<email>" SSO credentials without calling Google/GitHub.
# Honored only when APP_ENV is development/local; always rejected in production.
SSO_MOCK_MODE=false
