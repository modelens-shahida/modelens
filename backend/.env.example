# Database
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/modelens

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=generate-a-secure-secret-key-for-production-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage
STORAGE_BACKEND=local

# MLflow
MLFLOW_URI=http://localhost:5000

# Email Provider
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SES_REGION=us-east-1
FROM_EMAIL=no-reply@modelens.com

# Stripe
STRIPE_API_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_MOCK_MODE=true

# Environment: development | local | staging | production
APP_ENV=development
# true only in automated test runs (enables mock SSO credentials outside production)
TESTING=false

# SSO identity verification (server-side)
# Google OAuth client ID; ID tokens must have this as their audience
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GitHub OAuth app, used to exchange authorization codes server-side
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# Accept "mock:<email>" SSO credentials without calling Google/GitHub.
# Honored only when APP_ENV is development/local; always rejected in production.
SSO_MOCK_MODE=false

# SSO login rate limits (POST /api/v1/auth/sso-login); defaults shown
# Per client IP: requests allowed per window
SSO_RATE_LIMIT_REQUESTS=10
SSO_RATE_LIMIT_WINDOW_SECONDS=60
# Per account (provider-verified email): requests allowed per window
SSO_RATE_LIMIT_ACCOUNT_REQUESTS=5
SSO_RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=300
# Comma-separated IPs/CIDRs of your reverse proxies / load balancer. Only these may set
# X-Forwarded-For. Leave empty when clients connect to the API directly.
SSO_RATE_LIMIT_TRUSTED_PROXIES=

# Production dispatch rate limits (POST /api/v1/productions/dispatch); defaults shown
# Per brand, dispatches per minute; the admin "Orchestrator Limit" setting overrides it at runtime
ORCHESTRATOR_RATE_LIMIT=10
# Per user, across brands: dispatches allowed per window
DISPATCH_RATE_LIMIT_USER_REQUESTS=5
DISPATCH_RATE_LIMIT_USER_WINDOW_SECONDS=60
